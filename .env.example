# Public template only. Real passwords belong in the ignored .env file.
# Run scripts/Initialize-LocalEnvironment.ps1 to generate distinct random passwords.
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-password
ORDERS_DB_PASSWORD=replace-with-local-orders-password
INVENTORY_DB_PASSWORD=replace-with-local-inventory-password
PAYMENTS_DB_PASSWORD=replace-with-local-payments-password
NOTIFICATIONS_DB_PASSWORD=replace-with-local-notifications-password
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password
# Business rejection rate: 0 approves all; 1 declines all.
PAYMENT_FAILURE_RATE=0.15
# Technical failures before success: 0..10; values above 3 exercise the DLQ.
PAYMENT_TRANSIENT_FAILURES=0
